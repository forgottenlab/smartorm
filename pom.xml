<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>io.github.forgottenlab</groupId>
    <artifactId>smartorm-parent</artifactId>
    <version>2.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SmartORM Parent</name>
    <description>Build parent for SmartORM and its Spring Boot Starter</description>
    <url>https://github.com/forgottenlab/smartorm</url>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>forgottenlab</id>
            <name>ForgottenLab</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/forgottenlab/smartorm.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/forgottenlab/smartorm.git</developerConnection>
        <url>https://github.com/forgottenlab/smartorm</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>

    <modules>
        <module>smartorm</module>
        <module>smartorm-spring-boot-starter</module>
    </modules>

</project>
